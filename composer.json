{
    "name": "migears/domain",
    "description": "Minimalist Domain — data containers with array access and self-validation",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "domain",
        "dto",
        "data",
        "validation",
        "migears"
    ],
    "require": {
        "php": "^8.1",
        "migears/validator": "^2.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Domain\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Domain\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../migears-validator"
        }
    ],
    "scripts": {
        "test": "phpunit"
    }
}
